# Copiá este archivo como .env para probar en tu computadora.
# En Vercel, cargá las mismas variables en Settings → Environment Variables.

# --- Sitio de demostración ---
# true solo en la demo que les mostrás a los comercios (activa el usuario demo y los datos de ejemplo).
VITE_DEMO_MODE=false

# --- Firebase (navegador) ---
# Firebase → Configuración del proyecto → Tus apps → Configuración del SDK.
# Si se dejan vacías, se usa firebase-applet-config.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Solo si la base de Firestore no es "(default)".
VITE_FIREBASE_DATABASE_ID=

# --- Firebase (servidor, /api) ---
# JSON de la cuenta de servicio (Firebase → Configuración → Cuentas de servicio → Generar nueva clave privada).
# Se puede pegar el JSON entero o codificado en base64. NUNCA lo subas al repositorio.
FIREBASE_SERVICE_ACCOUNT=
# Igual que VITE_FIREBASE_DATABASE_ID.
FIREBASE_DATABASE_ID=

# --- Mercado Pago ---
# Access Token de producción de la cuenta del comercio (Mercado Pago → Tus integraciones → Credenciales).
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones → Webhooks). Recomendado.
MP_WEBHOOK_SECRET=

# --- Sitio ---
# Dirección pública de la tienda, sin barra final. Ej. https://www.mitienda.com.ar
PUBLIC_SITE_URL=

# --- Estadísticas (opcional) ---
VITE_GA_ID=
VITE_META_PIXEL_ID=
